+"""
+Generic Arrow Flight SQL engine spec over ADBC (SKETCH, not production-ready).
+
+Connects through ``sqlalchemy-adbc`` (``flightsql+adbc://``), whose DB-API
+cursor is an ADBC cursor, so result sets can be built with
+``SupersetResultSet.from_arrow`` (``supports_arrow_fetch``). Flight SQL is a
+protocol, not an engine: the server behind it may be DuckDB (GizmoSQL),
+DataFusion, Dremio, Doris, InfluxDB 3, ... so the time grains below stay on
+ANSI ``DATE_TRUNC``; engine-specific specs (e.g. DataFusion) can subclass.
+
+Open points (see README of the benchmark repo):
+* sqlalchemy-adbc requires Python >= 3.12; Superset still supports 3.11.
+* reflection (table list, column types) is reported broken in #45937.
+"""
+
+from sqlalchemy import types
+
+from superset.constants import TimeGrain
+from superset.db_engine_specs.base import BaseEngineSpec, DatabaseCategory
+
+
+class FlightSQLEngineSpec(BaseEngineSpec):
+    engine = "flightsql"
+    engine_name = "Arrow Flight SQL (ADBC)"
+    drivers = {"adbc": "ADBC Flight SQL driver via sqlalchemy-adbc"}
+    default_driver = "adbc"
+    sqlalchemy_uri_placeholder = "flightsql+adbc://user:password@host:port"
+    supports_file_upload = False
+    supports_arrow_fetch = True
+
+    metadata = {
+        "description": (
+            "Any Arrow Flight SQL server, through the ADBC Flight SQL driver."
+        ),
+        "homepage_url": "https://arrow.apache.org/adbc/",
+        "categories": [
+            DatabaseCategory.QUERY_ENGINES,
+            DatabaseCategory.OPEN_SOURCE,
+            DatabaseCategory.APACHE_PROJECTS,
+        ],
+        "pypi_packages": ["sqlalchemy-adbc[flightsql]"],
+        "connection_string": "flightsql+adbc://{username}:{password}@{host}:{port}",
+        "drivers": [
+            {
+                "name": "ADBC Flight SQL (Recommended)",
+                "pypi_package": "sqlalchemy-adbc[flightsql]",
+                "connection_string": (
+                    "flightsql+adbc://{username}:{password}@{host}:{port}"
+                ),
+                "is_recommended": True,
+            }
+        ],
+    }
+
+    _time_grain_expressions = {
+        None: "{col}",
+        TimeGrain.SECOND: "DATE_TRUNC('second', {col})",
+        TimeGrain.MINUTE: "DATE_TRUNC('minute', {col})",
+        TimeGrain.HOUR: "DATE_TRUNC('hour', {col})",
+        TimeGrain.DAY: "DATE_TRUNC('day', {col})",
+        TimeGrain.WEEK: "DATE_TRUNC('week', {col})",
+        TimeGrain.MONTH: "DATE_TRUNC('month', {col})",
+        TimeGrain.QUARTER: "DATE_TRUNC('quarter', {col})",
+        TimeGrain.YEAR: "DATE_TRUNC('year', {col})",
+    }
+
+    @classmethod
+    def epoch_to_dttm(cls) -> str:
+        return "to_timestamp({col})"
+
+    @classmethod
+    def convert_dttm(
+        cls,
+        target_type: str,
+        dttm,
+        db_extra=None,  # type: ignore[no-untyped-def]
+    ) -> str | None:
+        sqla_type = cls.get_sqla_column_type(target_type)
+        if isinstance(sqla_type, types.Date):
+            return f"DATE '{dttm.date().isoformat()}'"
+        if isinstance(sqla_type, types.TIMESTAMP):
+            return f"""TIMESTAMP '{dttm.isoformat(sep=" ", timespec="microseconds")}'"""
+        return None
