+    @staticmethod
+    def _arrow_table_method(cursor: Any) -> Any:
+        if hasattr(cursor, "to_arrow_table"):
+            return cursor.to_arrow_table
+        if hasattr(cursor, "fetch_arrow_table"):
+            return cursor.fetch_arrow_table
